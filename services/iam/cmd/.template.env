# The machine ID of the ID generator is SERVICE_ID<<8 | INSTANCE_ID. Each of the
# two values is from 0 to 255. Two running instances must not have the same
# machine ID.
SERVICE_ID=2
# The ID of the instance, for a deployment on Docker or on a VM. Each instance
# needs its own value. Do not set it for a StatefulSet in Kubernetes: the
# service then takes the ordinal of the pod name ("iam-2" gives 2).
 INSTANCE_ID=0

HTTP_SERVER_ADDR=":2008"
HTTP_SERVER_CERT_FILE=""
HTTP_SERVER_KEY_FILE=""
# HTTP timeouts. Zero or an absent key uses the default.
# A negative value (for example -1s) disables the timeout.
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=15s
HTTP_MAX_HEADER_BYTES=16384
## Auth0
#HTTP_SERVER_OIDC_ISSUER=https://your-tenant.us.auth0.com/
#HTTP_SERVER_OIDC_AUDIENCE=https://my-api
#HTTP_SERVER_OIDC_JWKS_URL=https://your-tenant.us.auth0.com/.well-known/jwks.json
# Local Keycloak: see deploy/auth/local/README.md
HTTP_SERVER_OIDC_ISSUER=http://localhost:8180/realms/iam-local
HTTP_SERVER_OIDC_AUDIENCE=iam-api
HTTP_SERVER_OIDC_JWKS_URL=http://localhost:8180/realms/iam-local/protocol/openid-connect/certs
# The realm in the WWW-Authenticate header. Optional. If it is empty, the
# header has no realm attribute.
HTTP_SERVER_BEARER_REALM=iam

# MySQL. The user, the database name, and the primary address are required.
SQL_DATABASE_USER=iam
SQL_DATABASE_PASSWORD=
SQL_DATABASE_NAME=iam
# The local compose file publishes MySQL on host port 9996.
SQL_DATABASE_PRIMARY_ADDRESS=127.0.0.1:9996
# Comma-separated list. Empty means that all reads go to the primary.
 SQL_DATABASE_REPLICA_ADDRESSES=
# Zero or an absent key uses the default. A negative value disables the limit.
 SQL_DATABASE_DIAL_TIMEOUT=3s
 SQL_DATABASE_READ_TIMEOUT=10s
 SQL_DATABASE_WRITE_TIMEOUT=5s
 SQL_DATABASE_SLOW_THRESHOLD=200ms
# Do not set this to true in production. The logged SQL then contains user data.
 SQL_DATABASE_LOG_PARAMETERS=false

# Ticket signing. Required. The key ID is from 1 to 255. The private key is a
# Base64 Ed25519 seed of 32 bytes. Do not commit a real key.
TICKET_SIGNING_KEY_ID=1
TICKET_SIGNING_PRIVATE_KEY=

# The path of the public descriptor file of the hub. Required.
HUB_NOISE_DESCRIPTOR_FILE=
