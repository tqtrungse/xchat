create_table   :users,
    options:   'ENGINE=InnoDB DEFAULT CHARSET=utf8mb4',
    collation: 'utf8mb4_general_ci',
    force:     :cascade,
    id:        { type: :bigint, unsigned: true, default: nil } do |t| # default: nil gives no AUTO_INCREMENT

    t.string  :external_id,   limit: 255,     null: false
    # user.IsValidUsername allows only [a-z0-9._-]{3,64}. ascii_bin compares
    # the bytes, so the unique index and the use case use the same equality.
    # The collation sets the ascii charset. Ridgepole exports no charset
    # option, so an explicit charset gives a diff.
    t.string  :username,      limit: 64,      null: false, collation: 'ascii_bin'
    t.binary  :password_hash, limit: 60,      null: false             # $2a$<cost>$<salt and hash>
    t.binary  :phone_hash,    limit: 16,      null: false             # HMAC-SHA256 truncated to 128 bits
    t.integer :phone_tail,    unsigned: true, null: false             # Last 3 digits: 032 -> 32, 123 -> 123
    t.integer :state,         limit: 2,       null: false, default: 1 # smallint. 1: active, 2: locked

    t.datetime :created_at, precision: 3, null: false, default: -> { 'CURRENT_TIMESTAMP(3)' }
    t.datetime :updated_at, precision: 3, null: false, default: -> { 'CURRENT_TIMESTAMP(3) ON UPDATE CURRENT_TIMESTAMP(3)' }

    t.index ['username'],   name: 'unique_index_users_on_username',   unique: true
    t.index ['phone_hash'], name: 'unique_index_users_on_phone_hash', unique: true
end