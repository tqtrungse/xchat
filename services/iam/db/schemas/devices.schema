create_table   :devices,
    options:   'ENGINE=InnoDB DEFAULT CHARSET=utf8mb4',
    collation: 'utf8mb4_0900_as_ci',
    force:     :cascade,
    id:        { type: :bigint, unsigned: true, default: nil } do |t| # default: nil gives no AUTO_INCREMENT

    t.bigint  :user_id,       unsigned: true, null: false
    t.string  :name,          limit: 128,     null: false             # Device type + OS name
    t.integer :state,                         null: false, default: 1 # 1: active, 2: locked
    t.binary  :peer_pub,      limit: 32,      null: false             # x25519
    t.binary  :identity_pub,  limit: 32,      null: false             # ed25519.GenerateKey(rand.Reader)

    t.datetime :created_at, precision: 3,  null: false, default: -> { 'CURRENT_TIMESTAMP(3)' }
    t.datetime :updated_at, precision: 3,  null: false, default: -> { 'CURRENT_TIMESTAMP(3) ON UPDATE CURRENT_TIMESTAMP(3)' }
    t.datetime :deleted_at, precision: 3
    t.datetime "seen_at",   precision: 3,  null: true

    t.index ['user_id'],      name: 'index_devices_on_user'
    t.index ['deleted_at'],   name: 'index_devices_on_deleted_at'

    t.index '`peer_pub`, (if((`deleted_at` is null),1,NULL))',
      name:   'unique_index_devices_on_peer_pub',
      unique: true
    t.index '`identity_pub`, (if((`deleted_at` is null),1,NULL))',
      name:   'unique_index_devices_on_identity_pub',
      unique: true

    t.check_constraint 'length(`peer_pub`) = 32',     name: 'check_devices_peer_pub_length'
    t.check_constraint 'length(`identity_pub`) = 32', name: 'check_devices_identity_pub_length'

    # The column is user_id and the primary key is id by default. Ridgepole
    # compares the options as written, so an explicit default gives a diff.
    t.foreign_key :users, name: 'fk_devices_users'
end