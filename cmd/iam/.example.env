SERVICE_ID=2

HTTP_SERVER_ADDR=":2008"
HTTP_SERVER_CERT_FILE=""
HTTP_SERVER_KEY_FILE=""
# HTTP timeouts. Zero or an absent key uses the default.
# A negative value (for example -1s) disables the timeout.
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=15s
HTTP_MAX_HEADER_BYTES=16384
## Auth0
#HTTP_SERVER_OIDC_ISSUER=https://your-tenant.us.auth0.com/
#HTTP_SERVER_OIDC_AUDIENCE=https://my-api
#HTTP_SERVER_OIDC_JWKS_URL=https://your-tenant.us.auth0.com/.well-known/jwks.json
# Local Keycloak: see deploy/auth/local/README.md
HTTP_SERVER_OIDC_ISSUER=http://localhost:8180/realms/iam-local
HTTP_SERVER_OIDC_AUDIENCE=iam-api
HTTP_SERVER_OIDC_JWKS_URL=http://localhost:8180/realms/iam-local/protocol/openid-connect/certs
